<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.archicontribs</groupId>
    <artifactId>archi-modelrepository-plugin</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>coArchi - Archi Model Repository Plugin</name>
    <description>Collaboration plugin for Archi using Git to store ArchiMate models</description>

    <properties>
        <revision>0.9.4-SNAPSHOT</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Archi version to download -->
        <archi.version>5.8.0</archi.version>
        <!-- Default to downloaded Archi; override with -Darchi.target.dir for local dev -->
        <archi.target.dir>${maven.multiModuleProjectDirectory}/target/archi-runtime/Archi</archi.target.dir>
        <!-- p2 file URL prefix: Linux paths start with / so file:// suffices;
             Windows paths start with C: so need file:/// (overridden in Windows profile) -->
        <archi.p2.url.prefix>file://</archi.p2.url.prefix>
        <!-- Set to true to skip Archi download+extract (auto-set by skip-archi-download profile) -->
        <archi.download.skip>false</archi.download.skip>
    </properties>
    
    <repositories>
        <!-- Eclipse 2024-06 platform -->
        <repository>
            <id>Eclipse</id>
            <layout>p2</layout>
            <url>https://download.eclipse.org/releases/2024-06</url>
        </repository>
        <!-- Archi bundles - downloaded to target/archi-runtime/ and published as p2 repo.
             p2 metadata (content.xml) is generated by FeaturesAndBundlesPublisher.
             file:// works on Linux (/home/... starts with /), Windows profile overrides
             to file:/// (needed for drive letter paths like C:/...) -->
        <repository>
            <id>archi-local</id>
            <layout>p2</layout>
            <url>${archi.p2.url.prefix}${archi.target.dir}</url>
        </repository>
    </repositories>

    <modules>
        <module>org.archicontribs.modelrepository</module>
        <module>org.archicontribs.modelrepository.commandline</module>
        <module>org.archicontribs.modelrepository.feature</module>
        <module>org.archicontribs.modelrepository.repository</module>
        <module>org.archicontribs.modelrepository.tests</module>
    </modules>

    <build>
        <plugins>
            <!-- Preserve archi-runtime during clean (download is expensive) -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <inherited>false</inherited>
                <configuration>
                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                    <filesets>
                        <fileset>
                            <directory>${project.build.directory}</directory>
                            <excludes>
                                <exclude>archi-runtime/**</exclude>
                            </excludes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <!-- Generate p2 metadata for Archi runtime (content.xml).
                 Archi ships with artifacts.xml but not content.xml, which Tycho needs
                 for p2 repository resolution. Uses the equinox launcher bundled with Archi.
                 Skips if content.xml already exists.
                 Uses Ant's pathconvert to resolve the launcher JAR glob. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>generate-p2-metadata</id>
                        <phase>initialize</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:unless="ant:unless">
                                <condition property="content.xml.exists">
                                    <available file="${archi.target.dir}/content.xml"/>
                                </condition>
                                <sequential unless:set="content.xml.exists">
                                    <pathconvert property="launcher.jar" setonempty="false">
                                        <fileset dir="${archi.target.dir}/plugins" includes="org.eclipse.equinox.launcher_*.jar"/>
                                    </pathconvert>
                                    <fail unless="launcher.jar" message="Equinox launcher JAR not found in ${archi.target.dir}/plugins"/>
                                    <!-- Build a proper file: URI from the path (handles both Linux and Windows) -->
                                    <makeurl property="archi.dir.uri" file="${archi.target.dir}"/>
                                    <echo message="Generating p2 metadata for Archi runtime at ${archi.dir.uri} ..."/>
                                    <java jar="${launcher.jar}" fork="true" failonerror="true" dir="${archi.target.dir}">
                                        <arg value="-application"/>
                                        <arg value="org.eclipse.equinox.p2.publisher.FeaturesAndBundlesPublisher"/>
                                        <arg value="-metadataRepository"/>
                                        <arg value="${archi.dir.uri}"/>
                                        <arg value="-artifactRepository"/>
                                        <arg value="${archi.dir.uri}"/>
                                        <arg value="-source"/>
                                        <arg value="${archi.target.dir}"/>
                                        <arg value="-publishArtifacts"/>
                                        <arg value="-append"/>
                                    </java>
                                    <echo message="Generated content.xml with p2 metadata"/>
                                </sequential>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho-version}</version>
                <extensions>true</extensions>
            </plugin>

            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-packaging-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>
            
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-compiler-plugin</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <useProjectSettings>false</useProjectSettings>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho-version}</version>
                <configuration>
                    <target>
                        <file>${maven.multiModuleProjectDirectory}/coarchi.target</file>
                    </target>
                    <environments>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>aarch64</arch>
                        </environment>
                    </environments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Skip download+extract when Archi runtime already exists.
             This prevents file lock errors when a previous test run's OSGi
             process still holds jar files open. -->
        <profile>
            <id>skip-archi-download</id>
            <activation>
                <file>
                    <exists>${maven.multiModuleProjectDirectory}/target/archi-runtime/Archi/artifacts.xml</exists>
                </file>
            </activation>
            <properties>
                <archi.download.skip>true</archi.download.skip>
            </properties>
        </profile>

        <!-- Download Archi runtime for target platform (OS-specific).
             Always active on the matching OS. The download plugin caches the
             archive in ~/.m2/repository/.cache/download-maven-plugin/ so
             repeated builds only re-extract, they don't re-download. -->
        <profile>
            <id>download-archi-linux</id>
            <activation>
                <os><family>unix</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.9.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>download-archi</id>
                                <phase>initialize</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>https://github.com/archimatetool/archi.io/releases/download/${archi.version}/Archi-Linux64-${archi.version}.tgz</url>
                                    <unpack>true</unpack>
                                    <outputDirectory>${maven.multiModuleProjectDirectory}/target/archi-runtime</outputDirectory>
                                    <skip>${archi.download.skip}</skip>
                                    <skipCache>false</skipCache>
                                    <overwrite>false</overwrite>
                                    <followRedirects>true</followRedirects>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>download-archi-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <!-- Windows paths start with drive letter (C:/) not /, need extra slash -->
                <archi.p2.url.prefix>file:///</archi.p2.url.prefix>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.9.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>download-archi</id>
                                <phase>initialize</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>https://github.com/archimatetool/archi.io/releases/download/${archi.version}/Archi-Win64-${archi.version}.zip</url>
                                    <unpack>true</unpack>
                                    <outputDirectory>${maven.multiModuleProjectDirectory}/target/archi-runtime</outputDirectory>
                                    <skip>${archi.download.skip}</skip>
                                    <skipCache>false</skipCache>
                                    <overwrite>false</overwrite>
                                    <followRedirects>true</followRedirects>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>download-archi-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.9.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>download-archi</id>
                                <phase>initialize</phase>
                                <goals><goal>wget</goal></goals>
                                <configuration>
                                    <url>https://github.com/archimatetool/archi.io/releases/download/${archi.version}/Archi-Mac-${archi.version}.dmg</url>
                                    <unpack>true</unpack>
                                    <outputDirectory>${maven.multiModuleProjectDirectory}/target/archi-runtime</outputDirectory>
                                    <skip>${archi.download.skip}</skip>
                                    <skipCache>false</skipCache>
                                    <overwrite>false</overwrite>
                                    <followRedirects>true</followRedirects>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
